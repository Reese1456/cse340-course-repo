<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <p>Here are a few of our partner organizations:</p>
    <ul class="org-list">
        <% organizations.forEach(organization => { %>
            <li>
                <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                <div>
                    <strong><a href="/organization/<%= organization.organization_id %>"><%= organization.name %></a></strong>
                    <p><%= organization.contact_email %></p>
                </div>
            </li>
        <% }); %>
    </ul>
    <% if (user && user.role_name === 'admin') { %>
        <p class="page-actions"><a class="button-link" href="/new-organization">Add a new organization</a></p>
    <% } %>
</main>

<%- include('partials/footer') %>
