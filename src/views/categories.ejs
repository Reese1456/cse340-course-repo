<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <p>Every service project is tagged with one or more of these categories.</p>
    <ul class="category-list">
        <% categories.forEach(category => { %>
            <li>
                <h2><a href="/category/<%= category.category_id %>"><%= category.name %></a></h2>
                <p><%= category.description %></p>
                <p class="category-count">
                    <%= category.project_count %> <%= category.project_count === 1 ? 'project' : 'projects' %>
                </p>
            </li>
        <% }); %>
    </ul>
    <% if (user && user.role_name === 'admin') { %>
        <p class="page-actions"><a class="button-link" href="/new-category">Add a New Category</a></p>
    <% } %>
</main>

<%- include('partials/footer') %>
